    "keep-alive",
    "auto-restart",
    "health-check",
    "log-rotation",
    "logs",
    "cron",
    "watch",
    "ecosystem",
    "ecosystem.config.js",
    "migration",
    "pm2-migration",
    "systemd",
    "launchd",
    "devops",
    "rust",
    "forever",
    "deployment",
    "uptime"
  ],
  "homepage": "https://github.com/gauravgitgithub/vexor#readme",
  "bugs": {
    "url": "https://github.com/gauravgitgithub/vexor/issues"
  },
